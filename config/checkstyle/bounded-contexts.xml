<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Bounded Context Enforcement (Enterprise hard-wall)

  Goal: make it mechanically impossible to reintroduce forbidden imports between AI domains.
    - Legal/Financial AI (com.tcc.pjb.backend.ai.juridica, com.tcc.pjb.backend.ai.financeira)

  This is a minimal, fast Checkstyle configuration executed in Maven's validate phase.
-->

<module name="Checker">

    <module name="TreeWalker">
        <module name="ImportControl">
            <property name="file" value="config/checkstyle/import-control.xml"/>
        </module>
    </module>

</module>
