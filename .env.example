# PJB — variáveis de ambiente para docker-compose
# Copie este arquivo para .env e preencha os valores marcados como REQUIRED

# ── Banco de dados ──────────────────────────────────────────────────────────
# PJB_DB_USER/PASS: superusuario inicial do container Postgres (initdb da imagem oficial
# sempre torna esse usuario superusuario — RLS nao vale para ele). Usado só para o container subir.
PJB_DB_NAME=pjb
PJB_DB_USER=pjb
PJB_DB_PASS=pjb
# PJB_DB_APP_USER/PASS: role restrita (NOSUPERUSER NOBYPASSRLS) criada por
# infra/docker/postgres/init/01-app-role.sh — é com essa role que o backend conecta de fato.
PJB_DB_APP_USER=pjb_app
PJB_DB_APP_PASS=pjb_app_pass
PJB_PG_PORT=5433

# ── Segurança — REQUIRED em produção ────────────────────────────────────────
# Gere com: openssl rand -base64 32
PJB_MASTER_KEY_BASE64=

# ── Kafka ───────────────────────────────────────────────────────────────────
PJB_KAFKA_PORT=9092
# Porta do listener externo (uso fora do Docker: IDE, CLI, Testcontainers)
PJB_KAFKA_HOST_PORT=19092

# ── Elasticsearch ───────────────────────────────────────────────────────────
PJB_ES_PORT=9200
PJB_ES_JAVA_OPTS=-Xms512m -Xmx512m

# ── Redis ───────────────────────────────────────────────────────────────────
PJB_REDIS_PORT=6379

# ── Backend ─────────────────────────────────────────────────────────────────
PJB_HTTP_PORT=8080

# ── JVM (opcional — pjb-runtime.sh gerencia automaticamente se omitido) ─────
# PJB_JVM_PROFILE=balanced        # balanced | latency | startup
# PJB_JAVA_OPTS=

# ── Integrações externas (opcional) ─────────────────────────────────────────
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# PJB_GOVBR_CLIENT_ID=
# PJB_GOVBR_CLIENT_SECRET=

# ── CNJ DataJud — REQUIRED se integração CNJ estiver habilitada ─────────────
# Obter em: https://www.cnj.jus.br/sistemas/datajud/api-publica/
# ATENÇÃO: a chave vazada em histórico Git DEVE SER ROTACIONADA no portal CNJ.
PJB_INSTITUTIONAL_CNJ_DATAJUD_API_KEY=
CNJ_DATAJUD_API_KEY=
# CNJ_DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br

# ── DataJud Feed (movimentações em lote) — REQUIRED se PJB_DATAJUD_FEED_ENABLED=true
# PJB_DATAJUD_FEED_BASE_URL=https://api-publica.datajud.cnj.jus.br
# PJB_DATAJUD_FEED_API_KEY=

# ── MNI (Modelo Nacional de Interoperabilidade) — REQUIRED se PJB_MNI_ENABLED=true
# PJB_MNI_BASE_URL=https://mni.cnj.jus.br
# PJB_MNI_TOKEN=

# ── SISBAJUD (bloqueio judicial de ativos) — REQUIRED se integração habilitada
# PJB_SISBAJUD_BASE_URL=https://sisbajud.cnj.jus.br/api
# PJB_SISBAJUD_TOKEN=

# ── RENAJUD (restrição judicial de veículos) — REQUIRED se integração habilitada
# PJB_RENAJUD_BASE_URL=https://renajud.denatran.serpro.gov.br/api
# PJB_RENAJUD_TOKEN=

# ── INFOJUD (informações patrimoniais Receita Federal) — REQUIRED se habilitada
# PJB_INFOJUD_BASE_URL=https://infojud.receita.fazenda.gov.br/api
# PJB_INFOJUD_TOKEN=

# ── BNMP (Banco Nacional de Monitoramento de Prisões) — REQUIRED se PJB_BNMP_ENABLED=true
# PJB_BNMP_BASE_URL=https://bnmp.cnj.jus.br/api/v1
# PJB_BNMP_TOKEN=

# ── N8N (automação de fluxos) — REQUIRED se PJB_N8N_ENABLED=true
# PJB_N8N_BASE_URL=https://n8n.local
# PJB_N8N_DISPATCH_SECRET=
# PJB_N8N_INBOUND_SECRET=
