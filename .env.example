# PJB — variáveis de ambiente para docker-compose
# Copie este arquivo para .env e preencha os valores marcados como REQUIRED

# ── Banco de dados ──────────────────────────────────────────────────────────
PJB_DB_NAME=pjb
PJB_DB_USER=pjb
PJB_DB_PASS=pjb
PJB_PG_PORT=5432

# ── Segurança — REQUIRED em produção ────────────────────────────────────────
# Gere com: openssl rand -base64 32
PJB_MASTER_KEY_BASE64=

# ── Kafka ───────────────────────────────────────────────────────────────────
PJB_KAFKA_PORT=9092

# ── Elasticsearch ───────────────────────────────────────────────────────────
PJB_ES_PORT=9200
PJB_ES_JAVA_OPTS=-Xms512m -Xmx512m

# ── Redis ───────────────────────────────────────────────────────────────────
PJB_REDIS_PORT=6379

# ── Backend ─────────────────────────────────────────────────────────────────
PJB_HTTP_PORT=8080

# ── JVM (opcional — pjb-runtime.sh gerencia automaticamente se omitido) ─────
# PJB_JVM_PROFILE=balanced        # balanced | latency | startup
# PJB_JAVA_OPTS=

# ── Integrações externas (opcional) ─────────────────────────────────────────
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# PJB_GOVBR_CLIENT_ID=
# PJB_GOVBR_CLIENT_SECRET=
