PJB_DB_NAME=pjb
PJB_DB_USER=pjb
PJB_DB_PASS=pjb
# Role restrita (NOSUPERUSER NOBYPASSRLS) usada pela aplicacao — ver
# infra/docker/postgres/init/01-app-role.sh
PJB_DB_APP_USER=pjb_app
PJB_DB_APP_PASS=pjb_app_pass
# Chave mestra AES-GCM (Base64, >= 32 bytes). Gere uma dev local com:
#   openssl rand -base64 32
# NUNCA use um bloco de zeros (chave valida em tamanho, catastroficamente insegura em valor);
# o compose falha propositalmente na subida se PJB_MASTER_KEY_BASE64 estiver em branco.
PJB_MASTER_KEY_BASE64=REPLACE_WITH_OUTPUT_OF_openssl_rand_-base64_32
PJB_ES_JAVA_OPTS=-Xms512m -Xmx512m
PJB_PGBOUNCER_RO_DB_HOST=postgres-replica

# ==== Vault (opcional, dev-mode via 'docker compose --profile vault up -d vault') ====
# Token de root para o Vault dev. Nao use em prod; ali, use auth method proprio
# (AppRole/Kubernetes/etc.) e nao root token estatico.
PJB_VAULT_DEV_ROOT_TOKEN=dev-root-CHANGE-ME
# Porta host onde o Vault dev fica exposto (default 8200).
PJB_VAULT_PORT=8200
# Para o VaultDbCredentialsProvider puxar credenciais do banco do Vault dev, apos bootstrap:
#   bash scripts/vault_dev_bootstrap.sh
# depois setar as 4 abaixo (mantidas comentadas por padrao para nao ativar rotacao acidentalmente):
# PJB_DB_CREDENTIALS_ROTATION_ENABLED=true
# PJB_DB_CREDENTIALS_ROTATION_VAULT_URL=http://localhost:8200
# PJB_DB_CREDENTIALS_ROTATION_VAULT_PATH=pjb/data/db/pjb
# PJB_VAULT_TOKEN=<token dedicado do backend, NAO o root token>

